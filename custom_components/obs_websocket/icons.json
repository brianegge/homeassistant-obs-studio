{
  "entity": {
    "sensor": {
      "stream_status": {
        "default": "mdi:broadcast",
        "state": {
          "streaming": "mdi:broadcast",
          "reconnecting": "mdi:broadcast-off",
          "idle": "mdi:broadcast-off"
        }
      },
      "stream_service": {
        "default": "mdi:cog-play"
      },
      "record_status": {
        "default": "mdi:record-rec",
        "state": {
          "recording": "mdi:record-rec",
          "paused": "mdi:pause-circle",
          "idle": "mdi:record"
        }
      }
    },
    "button": {
      "start_stream": {
        "default": "mdi:play"
      },
      "stop_stream": {
        "default": "mdi:stop"
      }
    }
  }
}
